services:
  lork:
    image: ghcr.io/the-treeline-project/lork-releases/lork:latest
    restart: unless-stopped
    ports:
      - "127.0.0.1:5090:5090"
    volumes:
      - ./config.yaml:/lork/config.yaml
      - ./proxies.txt:/lork/proxies.txt
    environment:
      - LORK_SERVER_PORT=5090
    # Docker keeps container logs forever by default. Lork logs a line per auth, so cap
    # them or they will fill the disk. 5 x 50 MB keeps roughly the last 250 MB.
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"
    deploy:
      resources:
        limits:
          memory: 4G
        reservations:
          memory: 2G
